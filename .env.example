# OpenIAM deployment root, no trailing slash
OPENIAM_BASE_URL=https://iam.example.com
# OAuth client: Access Control > Authentication Providers, grant "Client Credentials",
# Basic client auth, scopes covering /webconsole/rest/api/*
OPENIAM_CLIENT_ID=
OPENIAM_CLIENT_SECRET=
OPENIAM_VERIFY_TLS=true
OPENIAM_TIMEOUT_SECONDS=30

# Deployment-specific type ids used when a record doesn't give one
# (look them up in your webconsole or /webconsole/api-docs)
DEFAULT_USER_METADATA_TYPE_ID=
DEFAULT_EMAIL_TYPE_ID=
DEFAULT_PHONE_TYPE_ID=

# Callers of this backend must send X-API-Key: <value>. Leave empty only for local dev.
BACKEND_API_KEY=

# Change detection (see sync.example.yaml)
SYNC_CONFIG_PATH=sync.yaml
# true = run sync cycles in the background while `iam serve` runs
SYNC_SCHEDULE=false
# HMAC secret shared with the other site (webhook target)
SYNC_WEBHOOK_SECRET=

# Producer intake (see producer.example.yaml)
PRODUCER_CONFIG_PATH=producer.yaml

# This backend's own database (sync state, event outbox, producer records).
# NOT OpenIAM's database. Use a separate database, or at least this separate schema.
DATABASE_URL=postgresql+psycopg://backend_iam:CHANGE_ME@db.example.com:5432/backend_iam
DATABASE_SCHEMA=backend_iam
# Local development without PostgreSQL:
# DATABASE_URL=sqlite:///data/backend.db

# Logging (loguru). LOG_JSON=true: one JSON object per line, for log shippers.
LOG_LEVEL=INFO
LOG_JSON=false
# LOG_FILE=logs/backend-iam.log   (rotates at 50 MB, keeps 10)

# Consumer (remote site, see consumer.example.yaml). OPENIAM_* above = the remote OpenIAM.
CONSUMER_CONFIG_PATH=consumer.yaml

# Web UIs: `iam web` (producer site) and `iam oversight` (consumer site).
# First admin is created from these when no web user exists (then manage users in the UI).
WEB_USERNAME=admin
WEB_PASSWORD=
# Signs session cookies; same value on every instance of one UI. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_SECRET_KEY=
WEB_COOKIE_SECURE=true
WEB_IDLE_MINUTES=30
WEB_SESSION_HOURS=12
WEB_MAX_FAILURES=5
WEB_LOCK_MINUTES=15

# Consumer target: openiam (this site has OpenIAM) or ad (no OpenIAM: apply to AD).
CONSUMER_TARGET=openiam
AD_BIND_PASSWORD=
CONSUMER_METRICS_HOST=127.0.0.1
CONSUMER_METRICS_PORT=9102

# API protection (named keys: `iam apikey create`; BACKEND_API_KEY is a bootstrap key).
API_ALLOWED_CIDRS=
TRUSTED_PROXIES=
API_RATE_PER_MINUTE=600
MAX_REQUEST_BYTES=26214400

# Retention in days (0 = keep forever).
RETENTION_OUTBOX_DAYS=90
RETENTION_RUNS_DAYS=180
RETENTION_ACTIVITY_DAYS=365
RETENTION_AUDIT_DAYS=730

# Mask e-mail addresses and phone numbers in logs.
LOG_REDACT=true
